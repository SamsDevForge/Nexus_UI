# Frontend runtime. Keep mock mode unless a Phase 6 backend is configured.
NEXT_PUBLIC_NEXUS_RUNTIME_MODE=mock
NEXT_PUBLIC_NEXUS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# FastAPI runtime. These values belong in backend/.env for local live-mode work.
APP_ENV=development
DATABASE_URL=
MIGRATION_DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
LOG_LEVEL=INFO

# Public-context development slice (default disabled).
# Set in backend/.env to enable. Production still requires verified Firebase identity.
PUBLIC_CONTEXT_ENABLED=false
# Optional OSRM driving router. No live traffic; blank means use entered journey time.
OSRM_BASE_URL=
# Server-side Next.js proxy target. No browser-visible keys are required.
NEXUS_CONTEXT_API_URL=http://127.0.0.1:8000
