# Frontend runtime. Keep mock mode unless a Phase 6 backend is configured.
NEXT_PUBLIC_NEXUS_RUNTIME_MODE=mock
NEXT_PUBLIC_NEXUS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# FastAPI runtime. These values belong in backend/.env for local live-mode work.
APP_ENV=development
DATABASE_URL=
MIGRATION_DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
LOG_LEVEL=INFO
