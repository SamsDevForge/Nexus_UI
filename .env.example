# Frontend runtime. Keep mock mode unless a Phase 6 backend is configured.
NEXT_PUBLIC_NEXUS_RUNTIME_MODE=mock
NEXT_PUBLIC_NEXUS_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# FastAPI runtime. These values belong in backend/.env for local live-mode work.
APP_ENV=development
DATABASE_URL=
MIGRATION_DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
LOG_LEVEL=INFO

# Public-context development slice (default disabled).
# Set in backend/.env to enable. Production still requires verified Firebase identity.
PUBLIC_CONTEXT_ENABLED=false
# Optional OSRM driving router. No live traffic; blank means use entered journey time.
OSRM_BASE_URL=
# Server-side Next.js proxy target. No browser-visible keys are required.
NEXUS_CONTEXT_API_URL=http://127.0.0.1:8000

# Phase 8: all schedules are also opt-in per user; start the worker separately.
NOTIFICATIONS_ENABLED=false
PUSH_ENABLED=false
# Backend-only Fernet key. Never place it in a NEXT_PUBLIC variable.
PUSH_TOKEN_ENCRYPTION_KEY=
# Public Web Push certificate key from Firebase, returned only to signed-in clients.
FCM_WEB_VAPID_PUBLIC_KEY=

# Phase 9 calendar: backend-only. Manual/ICS/timetable need only the feature flag.
CALENDAR_ENABLED=false
# A separate Fernet key; generate as described in docs/PHASE_09_CALENDAR.md.
CALENDAR_ENCRYPTION_KEY=
# Origins only; HTTPS required except localhost in development/test.
CALENDAR_API_PUBLIC_URL=
CALENDAR_WEB_URL=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
